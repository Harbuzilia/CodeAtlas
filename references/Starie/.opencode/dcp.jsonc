{
    "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
    "enabled": true,
    "pruneNotification": "minimal",
    // Slash commands: /dcp, /dcp context, /dcp stats, /dcp sweep
    "commands": {
        "enabled": true,
        "protectedTools": []
    },
    "turnProtection": {
        "enabled": true,
        "turns": 4
    },
    "tools": {
        "settings": {
            "nudgeEnabled": true,
            "nudgeFrequency": 10
        },
        "discard": {
            "enabled": true
        },
        "extract": {
            "enabled": true,
            "showDistillation": false
        }
    },
    "strategies": {
        "deduplication": {
            "enabled": true
        },
        "supersedeWrites": {
            "enabled": true
        },
        "purgeErrors": {
            "enabled": true,
            "turns": 4
        }
    }
}