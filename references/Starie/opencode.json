  "permission": {
    "bash": "ask",
    "edit": "allow",
    "write": "allow"
  },
  "plugin": [
    "opencode-antigravity-auth@beta",
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless",
        "--caps",
        "vision"
      ],
      "timeout": 300000,
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "timeout": 30000
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:/AllMyProject",
        "C:/Users/Harb/.config/opencode"
      ]
    }
  },
  "command": {
    "quick": {
      "template": "Быстро ответь на вопрос без лишних деталей: $ARGUMENTS",
      "description": "Быстрый ответ (экономия токенов)",
      "model": "google/antigravity-gemini-3-flash"
    },
    "plan": {
      "template": "Создай детальный план реализации: $ARGUMENTS\nНе пиши код, только план.",
      "description": "Планирование без кода",
      "agent": "plan"
    },
    "review": {
      "template": "Проведи code review для: $ARGUMENTS\nФокус: безопасность, производительность, читаемость.",
      "description": "Code review",
      "model": "google/antigravity-gemini-3-pro:high"
    },
    "optimize": {
      "template": "Оптимизируй код: $ARGUMENTS\nФокус: производительность и чистота кода.",
      "description": "Оптимизация кода"
    },
    "test": {
      "template": "Напиши тесты для: $ARGUMENTS",
      "description": "Генерация тестов"
    },
    "doc": {
      "template": "Создай документацию для: $ARGUMENTS",
      "description": "Генерация документации",
      "model": "google/antigravity-gemini-3-flash"
    },
    "fix": {
      "template": "Исправь ошибку/проблему: $ARGUMENTS\nБыстро найди причину и исправь. Минимум объяснений, максимум действий.",
      "description": "Быстрое исправление ошибок"
    },
    "explain": {
      "template": "Объясни как работает этот код: $ARGUMENTS\nПошагово, понятным языком.",
      "description": "Объяснение кода",
      "model": "google/antigravity-gemini-3-flash"
    },
    "refactor": {
      "template": "Отрефактори код: $ARGUMENTS\nУлучши структуру, читаемость, следуй SOLID.",
      "description": "Рефакторинг кода"
    },
    "debug": {
      "template": "Помоги найти и исправить баг: $ARGUMENTS\nСистематично проанализируй, найди причину, предложи решение.",
      "description": "Отладка и поиск багов"
    },
    "turbo": {
      "template": "[TURBO MODE] Выполни БЕЗ лишних вопросов и подтверждений, действуй быстро: $ARGUMENTS",
      "description": "Турбо-режим (запуск с --yolo для полного эффекта)"
    },
    "wf-smart": {
      "template": "$ARGUMENTS",
      "description": "Умный оркестратор — использует готовые workflows или генерирует новые",
      "agent": "orchestrator/workflow-builder"
    },
    "build-context-system": {
      "template": "@command/build-context-system.md\n$ARGUMENTS",
      "description": "Интерактивный конструктор контекстной системы",
      "agent": "core/openagent"
    },
    "menu": {
      "template": "@command/menu.md",
      "description": "Стартовое меню режимов"
    },
    "commit": {
      "template": "@command/commit.md\n$ARGUMENTS",
      "description": "Профессиональные git commits"
    },
    "prompt-optimizer": {
      "template": "@command/prompt-engineering/prompt-optimizer.md\n$ARGUMENTS",
      "description": "Оптимизация промптов"
    }
  },
  "share": "manual",
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "build/**",
      ".next/**",
      "__pycache__/**",
      "*.pyc",
      ".venv/**",
      "venv/**"
    ]
  },
  "lsp": {},
  "keybinds": {
    "leader": "ctrl+x",
    "agent_list": "<leader>a",
    "agent_cycle": "tab",
    "agent_cycle_reverse": "shift+tab",
    "model_list": "<leader>m",
    "model_cycle_recent": "f2",
    "variant_cycle": "ctrl+t",
    "command_list": "ctrl+p",
    "session_new": "<leader>n",
    "session_list": "<leader>l",
    "session_compact": "<leader>c",
    "session_interrupt": "escape",
    "messages_undo": "<leader>u",
    "messages_redo": "<leader>r",
    "messages_copy": "<leader>y",
    "editor_open": "<leader>e",
    "sidebar_toggle": "<leader>b",
    "app_exit": "ctrl+c,ctrl+d,<leader>q"
  }
}