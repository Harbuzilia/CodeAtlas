{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/antigravity-gemini-3-pro:high",
  "small_model": "google/antigravity-gemini-3-flash",
  "default_agent": "core/openagent",
  "permission": {
    "bash": {
      "git status": "allow",
      "ls": "allow",
      "pwd": "allow",
      "git diff": "allow",
      "python --version": "allow",
      "npm list": "allow",
      "*": "ask"
    },
    "edit": {
      "**/*.env*": "deny",
      ".git/**": "deny"
    }
  },
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
