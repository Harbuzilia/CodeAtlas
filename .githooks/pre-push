#!/bin/sh
# OpenCode Pre-push Hook
# Routing conformance + unit tests before code leaves the machine.

echo "Running OpenCode Pre-push Gates (eval:routes, test)..."
npm run eval:routes && npm test

EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
    printf '\n❌ [ERROR] Pre-push gates failed (routing evaluation or unit tests). Fix them before pushing.\n'
    exit 1
fi

echo "✅ [SUCCESS] Routing evaluation and unit tests passed."
exit 0
