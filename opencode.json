{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "instructions.md"
  ],
  "model": "google/antigravity-gemini-3-pro:high",
  "small_model": "google/antigravity-gemini-3-flash",
  "default_agent": "openagent",
  "permission": {
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -rf /*": "deny",
      "format c:*": "deny",
      "drop database*": "deny",
      "drop table*": "deny",
      "sudo *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "truncate table*": "ask",
      "shutdown*": "ask"
    },
    "edit": {
      "**/*.env*": "deny",
      ".git/**": "deny"
    }
  },
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65535
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingLevel": "low"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "minimal": {
              "thinkingLevel": "minimal"
            },
            "low": {
              "thinkingLevel": "low"
            },
            "medium": {
              "thinkingLevel": "medium"
            },
            "high": {
              "thinkingLevel": "high"
            }
          }
        },
        "antigravity-claude-sonnet-4-5": {
          "name": "Claude Sonnet 4.5 (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "antigravity-claude-sonnet-4-5-thinking": {
          "name": "Claude Sonnet 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-claude-opus-4-5-thinking": {
          "name": "Claude Opus 4.5 Thinking (Antigravity)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          },
          "variants": {
            "low": {
              "thinkingConfig": {
                "thinkingBudget": 8192
              }
            },
            "max": {
              "thinkingConfig": {
                "thinkingBudget": 32768
              }
            }
          }
        },
        "antigravity-gpt-oss-120b": {
          "name": "GPT-OSS 120B"
        }
      }
    }
  },
  "agent": {
    "openagent": {
      "path": "agents/openagent.md"
    },
    "contextscout": {
      "path": "agents/contextscout.md"
    },
    "coder": {
      "path": "agents/coder.md"
    },
    "tester": {
      "path": "agents/tester.md"
    },
    "reviewer": {
      "path": "agents/reviewer.md"
    },
    "debugger": {
      "path": "agents/debugger.md"
    },
    "planner": {
      "path": "agents/planner.md"
    },
    "externalscout": {
      "path": "agents/externalscout.md"
    },
    "docwriter": {
      "path": "agents/docwriter.md"
    },
    "uitester": {
      "path": "agents/uitester.md"
    },
    "architect": {
      "path": "agents/architect.md"
    },
    "devops": {
      "path": "agents/devops.md"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "github-grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    }
  },
  "plugin": [
    "opencode-antigravity-auth@beta",
    "@tarquinen/opencode-dcp@latest"
  ]
}
