    "impact": "node scripts/ast-impact.mjs",
    "test:gap": "node scripts/test-coverage-gap.mjs",
    "docgen": "node scripts/doc-generator.mjs",
    "budget": "node scripts/token-budget-tracker.mjs",
    "bench": "node scripts/run-benchmarks.mjs",
    "doctor": "node scripts/opencode-doctor.mjs",
    "db:explain": "node scripts/db-query-advisor.mjs",
    "matrix": "node scripts/agent-matrix.mjs",
    "heal": "node scripts/autonomous-sandbox-loop.mjs",
    "drift": "node scripts/contract-drift-sentinel.mjs",
    "synthesize": "node scripts/spec-synthesizer.mjs",
    "memory": "node scripts/swarm-memory.mjs",
    "test:smart": "node scripts/smart-test-runner.mjs",
