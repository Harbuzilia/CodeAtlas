    "arch": "node scripts/arch-visualizer.mjs",
    "oracle": "node scripts/defect-oracle.mjs",
    "pr:auto": "node scripts/ai-pr-bot.mjs",
    "test:flaky": "node scripts/flaky-test-hunter.mjs",
    "memory:compact": "node scripts/agent-memory-compactor.mjs",
