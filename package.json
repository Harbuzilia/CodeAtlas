    "sync:all": "node scripts/sync-targets.mjs",
    "menu:gen": "node scripts/generate-menu.mjs",
    "heal:config": "node scripts/heal-config.mjs",
    "telemetry": "node scripts/routing-telemetry.mjs",
    "onboard": "node scripts/onboard.mjs",
    "watch": "node scripts/watch.mjs",
    "eval:routes:llm": "node scripts/eval-scenarios.mjs --llm",
